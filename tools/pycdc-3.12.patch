+/* The class node keeps its name as a plain string object, which would print as
+ * `class 'Foo':`. Turn it into a name node when hoisting a decorated class. */
+static PycRef<ASTNode> ClassNameNode(PycRef<ASTNode> cls)
+{
+    PycRef<ASTNode> name = cls.cast<ASTClass>()->name();
+    if (name.type() == ASTNode::NODE_OBJECT) {
+        PycRef<PycObject> obj = name.cast<ASTObject>()->object();
+        if (obj != nullptr) {
+            switch (obj->type()) {
+            case PycObject::TYPE_STRING:
+            case PycObject::TYPE_UNICODE:
+            case PycObject::TYPE_ASCII:
+            case PycObject::TYPE_INTERNED:
+            case PycObject::TYPE_ASCII_INTERNED:
+            case PycObject::TYPE_SHORT_ASCII:
+            case PycObject::TYPE_SHORT_ASCII_INTERNED:
+                return new ASTName(obj.cast<PycString>());
+            default:
+                break;
+            }
+        }
+    }
+    return name;
+}
